generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum RoomRole {
  OWNER
  MODERATOR
  MEMBER
}

enum RoomStatus {
  WAITING
  PLAYING
  PAUSED
  ENDED
}

model User {
  id           String        @id @default(cuid())
  username     String?       @unique @db.VarChar(50)
  passwordHash String?       @db.VarChar(255)
  displayName  String        @db.VarChar(40)
  avatarUrl    String?       @db.VarChar(500)
  exp          Int           @default(0)
  balance      Int           @default(0)
  totalDonated Int           @default(0)
  shirtColor   String?       @db.VarChar(20)
  hairStyle    String?       @db.VarChar(30)
  accessory    String?       @db.VarChar(30)
  createdAt    DateTime      @default(now())
  roomsOwned   Room[]        @relation("RoomOwner")
  memberships  RoomMember[]
  messages     ChatMessage[]
  donations    Donation[]
  missions     MissionProgress[]
  videoQueueItemsAddedBy VideoQueueItem[] @relation("VideoQueueAddedBy")
  videoQueueItemsApprovedBy VideoQueueItem[] @relation("VideoQueueApprovedBy")
}

model Room {
  id                 String         @id @default(cuid())
  code               String         @unique @db.VarChar(12)
  name               String         @db.VarChar(100)
  description        String?        @db.VarChar(500)
  visibility         RoomVisibility @default(PUBLIC)
  passwordHash       String?        @db.VarChar(255)
  maxMembers         Int            @default(100)
  allowMemberControl Boolean        @default(false)
  status             RoomStatus     @default(WAITING)
  theme              String?        @db.VarChar(20)
  ownerId            String
  owner              User           @relation("RoomOwner", fields: [ownerId], references: [id])
  video              Video?
  members            RoomMember[]
  playback           PlaybackState?
  messages           ChatMessage[]
  reactions          Reaction[]
  seats              Seat[]
  videoQueueItems    VideoQueueItem[]
  donations          Donation[]
  missionProgress    MissionProgress[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  @@index([visibility, status, createdAt])
}

model Video {
  id          String   @id @default(cuid())
  roomId      String   @unique
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(200)
  sourceUrl   String   @db.VarChar(2000)
  posterUrl   String?  @db.VarChar(1000)
  durationSec Int?
  createdAt   DateTime @default(now())
}

model RoomMember {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RoomRole  @default(MEMBER)
  seatId    String?
  seatLabel String?   @db.VarChar(12)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  @@unique([roomId, userId])
  @@index([roomId, leftAt])
}

model PlaybackState {
  id             String   @id @default(cuid())
  roomId         String   @unique
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  isPlaying      Boolean  @default(false)
  positionSec    Float    @default(0)
  playbackRate   Float    @default(1)
  sourceUrl      String?  @db.VarChar(2000)
  videoTitle     String?  @db.VarChar(200)
  updatedAt      DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String   @db.VarChar(1000)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@index([roomId, createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  emoji     String   @db.VarChar(16)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([roomId, createdAt])
}

model Seat {
  id       String @id @default(cuid())
  roomId   String
  label    String @db.VarChar(12)
  x        Float
  z        Float
  room     Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@unique([roomId, label])
}

enum VideoQueueStatus {
  PENDING
  APPROVED
  PLAYING
  PLAYED
  REJECTED
}

model VideoQueueItem {
  id          String          @id @default(cuid())
  roomId      String
  room        Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  addedById   String
  addedBy     User            @relation("VideoQueueAddedBy", fields: [addedById], references: [id])
  title       String          @db.VarChar(200)
  sourceUrl   String          @db.VarChar(2000)
  type        String          @db.VarChar(20) // YouTube, TikTok, SoundCloud, Trực tiếp, Khác
  durationMin String?         @db.VarChar(20) // "under5", "5-20", "over20"
  hasSubtitle String?         @db.VarChar(20) // "yes", "no", "unknown"
  note        String?         @db.VarChar(500) // Ghi chú cho người duyệt
  status      VideoQueueStatus @default(PENDING)
  approvedById String?
  approvedBy   User?          @relation("VideoQueueApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt   DateTime        @default(now())
  @@index([roomId, status])
  @@index([roomId, createdAt])
}

model Donation {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Int      // số tiền VND
  message     String?  @db.VarChar(200)
  createdAt   DateTime @default(now())
  @@index([roomId, createdAt])
}

model MissionProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  missionKey  String   @db.VarChar(50) // daily_checkin, chat_5, video_approved, watch_30min, support, invite
  progress    Int      @default(0)
  target      Int      @default(1)
  completed   Boolean  @default(false)
  claimed     Boolean  @default(false)
  expReward   Int      @default(0)
  updatedAt   DateTime @updatedAt
  @@unique([userId, roomId, missionKey])
  @@index([userId, completed])
}
