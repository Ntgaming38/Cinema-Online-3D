# === Cinema Online 3D — environment template ===
# Copy to .env locally, or set the same names in the Botkeep panel (Environment tab).
# NEVER commit a real .env. See DEPLOY-BOTKEEP.md for the full Botkeep guide.

# Database (required). TiDB Cloud connection string from your cluster,
# or the local docker-compose MySQL for development.
DATABASE_URL="mysql://root:cinema_dev_password@127.0.0.1:4000/tcg_cinema"

# Auth (required in production). Keep the SAME value on the web server and
# the realtime server, and keep the existing production value unchanged.
JWT_SECRET="tcg-cinema-secret-example-key"

NODE_ENV=production

# --- Realtime address seen by the BROWSER (Next.js inlines NEXT_PUBLIC_* at build time) ---
# Split mode (realtime on its own Botkeep server): set this to that server's
# public https origin, e.g. NEXT_PUBLIC_REALTIME_URL="https://<realtime-domain>"
# and rebuild/redeploy the web app afterwards.
# Combined mode (npm run start:all gateway) or unset: leave EMPTY — production
# builds then fall back to the page's own origin (same-origin /socket.io/).
# Local dev default when unset and NODE_ENV is not production: http://localhost:4001
NEXT_PUBLIC_REALTIME_URL="http://localhost:4001"

# --- Realtime server (apps/realtime) ---
# Port priority in code: SERVER_PORT || PORT || REALTIME_PORT || 4001.
# On Botkeep, SERVER_PORT is assigned by the platform — do NOT set it manually.
REALTIME_PORT=4001
# CORS allow-list for the realtime server: comma-separated WEB origins,
# e.g. WEB_ORIGIN="https://<web-domain>". A single "*" allows any origin
# (reflected back per-request) — handy before the web domain is known.
WEB_ORIGIN="http://localhost:3000,http://localhost:3001"

# --- Botkeep-provided (do NOT set manually) ---
# SERVER_PORT=<assigned by Botkeep at runtime>
# PORT=<sometimes also provided by the platform>
